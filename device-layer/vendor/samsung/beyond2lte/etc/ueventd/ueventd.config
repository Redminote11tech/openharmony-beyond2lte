# SPDX-License-Identifier: Apache-2.0
# S10+ development overlay. Drivers/config verified in the staged Exynos
# kernel; runtime ownership and hardware-service access remain untested.
# No MediaTek DMA heaps, DSP, sensorhub or USB controller assumptions.
[device]
/dev/graphics/fb0         0660  graphics      graphics
/dev/mali0                0660  graphics      graphics
/dev/ion                  0660  graphics      graphics
/dev/input/event*         0660  root          android_input
/dev/access_token_id      0666  access_token  access_token
