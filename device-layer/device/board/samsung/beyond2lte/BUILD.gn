import("//build/ohos.gni")
import("device.gni")

group("beyond2lte_group") {
  # S2'-S4' scope: cfg overlays only (hdcd, perms, input caps, composer gate).
  # audio_alsa / audio_hal / launcher are MTK-specific (Volla) — quarantined
  # in _mtk_reference/ for the audio stage (S6). See ORIGIN-AND-TODO.md.
