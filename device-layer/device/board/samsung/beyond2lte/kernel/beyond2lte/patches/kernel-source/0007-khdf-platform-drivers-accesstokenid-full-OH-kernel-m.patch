diff --git a/include/hdf/platform/pcie_if.h b/include/hdf/platform/pcie_if.h
new file mode 100644
index 000000000..6ebbdcd60
--- /dev/null
+++ b/include/hdf/platform/pcie_if.h
@@ -0,0 +1,167 @@
+/*
