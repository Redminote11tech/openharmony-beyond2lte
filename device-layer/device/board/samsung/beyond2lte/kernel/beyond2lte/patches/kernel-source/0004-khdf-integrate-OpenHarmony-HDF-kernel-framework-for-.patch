+    if head_path:
+        file_head_path_full = head_path.replace("\\", "/")
+        date_replace['head_path'] = '/'.join(file_head_path_full.split(
+            relatively_path)[-1].split('/')[:-1]).strip('/')
+    return date_replace
+
