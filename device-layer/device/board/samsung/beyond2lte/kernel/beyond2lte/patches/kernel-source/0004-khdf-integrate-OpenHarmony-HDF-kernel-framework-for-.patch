+
+    /* parse hcs config. */
+#if HCS_NODE_HAS_PROP(PLATFORM_CONFIG, mmc_config)
+    HCS_FOREACH_CHILD_VARGS(MMC_CNTLR_PARSE_CONFIG, MMC_FIND_CONFIG, obj->deviceMatchAttr, cntlr);
+#endif
+
+    return HDF_SUCCESS;
