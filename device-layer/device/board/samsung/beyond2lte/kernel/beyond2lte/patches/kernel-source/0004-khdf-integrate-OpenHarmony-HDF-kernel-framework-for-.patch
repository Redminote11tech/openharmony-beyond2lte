+
+enum PowerType {
+    GPIO_POWER,
+    REGULATOR_POWER,
+};
+
+struct PanelCmd {
+    struct DsiCmdDesc  *dsiCmd;
+    uint32_t           count;
+};
+
+struct PowerDesc {
+    uint32_t type;
+    uint32_t num;
+    uint32_t vol;
+};
+
+struct PowerCtrl {
+    uint32_t type;
+    uint32_t num;
+    uint32_t opt;
+    uint32_t delay;
+};
+
+struct PowerSequeue {
+    struct PowerCtrl  *pwCtrl;
