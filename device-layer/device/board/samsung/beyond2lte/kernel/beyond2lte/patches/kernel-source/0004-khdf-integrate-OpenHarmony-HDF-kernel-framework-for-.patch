+static int32_t BytesToFrames(uint32_t frameBits, uint32_t size, uint32_t *pointer)
+{
+    if (pointer == NULL || frameBits == 0) {
+        AUDIO_DEVICE_LOG_ERR("input para is error.");
+        return HDF_FAILURE;
+    }
+    *pointer = size / frameBits;
+    return HDF_SUCCESS;
+}
