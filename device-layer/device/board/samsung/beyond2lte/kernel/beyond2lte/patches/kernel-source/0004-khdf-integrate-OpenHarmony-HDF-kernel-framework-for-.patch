+            list(filter(lambda x: x, head_path.split("model")[-1].strip(
+                os.path.sep).split(os.path.sep)[2:-1])))
+    }
+    new_line = temp_handle.substitute(
+        temp_replace).replace("FRAMEWORKS", "$FRAMEWORKS")
+    return new_line
