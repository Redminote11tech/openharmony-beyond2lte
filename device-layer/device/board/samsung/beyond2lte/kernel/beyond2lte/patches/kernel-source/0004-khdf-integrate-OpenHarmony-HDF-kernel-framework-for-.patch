+static int32_t HdfPcieInit(struct BusDev *dev, const struct HdfConfigWlanBus *busCfg)
+{
+    struct DevHandle *handle = NULL;
+    if (dev == NULL || busCfg == NULL) {
+        HDF_LOGE("%s: input parameter error!", __func__);
+        return HDF_FAILURE;
