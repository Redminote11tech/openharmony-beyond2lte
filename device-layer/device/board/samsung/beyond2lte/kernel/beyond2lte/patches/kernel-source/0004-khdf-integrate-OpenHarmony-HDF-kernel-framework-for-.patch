+void AstObject::Separate()
+{
+    if (parent_ == nullptr) {
+        return;
+    }
+    if (parent_->child_.get() == this) {
+        parent_->child_ = next_; // decref this
+        next_ = nullptr;
+        return;
+    }
+
+    auto pre = parent_->child_;
+    while (pre != nullptr) {
+        if (pre->next_.get() == this) {
+            pre->next_ = pre->next_->next_; // decref this
+            break;
+        }
+
+        pre = pre->next_;
+    }
+    next_ = nullptr;
+}
