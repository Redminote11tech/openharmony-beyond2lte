+
+AttrEditor.ATTR_TYPE_STR = ['整数', '字符串', '数组', '布尔', '引用', '删除'];
+
+AttrEditor.pInstance_ = null;
+AttrEditor.gi = function () {
+  if (AttrEditor.pInstance_ === null) {
+    AttrEditor.pInstance_ = new AttrEditor();
+  }
+  return AttrEditor.pInstance_;
+};
+
+module.exports = {
+  AttrEditor,
+};
