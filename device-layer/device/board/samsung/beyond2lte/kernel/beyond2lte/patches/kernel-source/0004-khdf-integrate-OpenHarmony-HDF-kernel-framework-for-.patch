+    handle = (struct DevHandle *)dev->devBase;
+    SdioClaimHost(handle);
+}
+
+static void HdfSdioReleaseHost(struct BusDev *dev)
+{
+    struct DevHandle *handle = NULL;
+    if (dev == NULL) {
+        HDF_LOGE("%s:input parameter error!", __func__);
+        return;
+    }
+    handle = (struct DevHandle *)dev->devBase;
+    SdioReleaseHost(handle);
+}
