+    ret = BufferQueueStreamOff(&streamDev->queueImp.queue);
+    if (ret != HDF_SUCCESS) {
+        HDF_LOGE("%s: Driver BufferQueueStreamOff failed, line: %{public}d", __func__, __LINE__);
+        return ret;
+    }
