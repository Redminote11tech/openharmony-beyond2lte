+#ifndef PCIE_CORE_H
+#define PCIE_CORE_H
+
+#include "hdf_base.h"
+#include "hdf_device_desc.h"
+#include "osal_mutex.h"
+#include "pcie_if.h"
+#include "platform_core.h"
+
