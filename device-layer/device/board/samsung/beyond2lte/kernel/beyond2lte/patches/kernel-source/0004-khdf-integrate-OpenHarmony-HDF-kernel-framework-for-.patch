+        return HDF_ERR_INVALID_PARAM;
+    }
+    return sdio_claim_irq(func, (sdio_irq_handler_t *)handler);
+}
+
+static int32_t LinuxSdioReleaseIrq(struct SdioDevice *dev)
+{
+    struct sdio_func *func = LinuxSdioGetFunc(dev);
