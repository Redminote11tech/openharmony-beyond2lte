+static uint32_t GetSensorRegGroupNameIndex(const char *name)
+{
+    uint32_t index;
+
+    if (name == NULL) {
+        return SENSOR_GROUP_MAX;
+    }
+
+    for (index = 0; index < SENSOR_GROUP_MAX; ++index) {
+        if ((g_sensorRegGroupName[index] != NULL) && (strcmp(name, g_sensorRegGroupName[index]) == 0)) {
+            break;
+        }
