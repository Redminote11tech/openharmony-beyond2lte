+            time.tv_nsec -= HDF_NANO_UNITS;
+            time.tv_sec += 1;
+        }
+        int32_t ret = sem_timedwait((sem_t *)sem->realSemaphore, &time);
+        if (ret != 0) {
+            if (errno == ETIMEDOUT) {
+                return HDF_ERR_TIMEOUT;
+            } else {
