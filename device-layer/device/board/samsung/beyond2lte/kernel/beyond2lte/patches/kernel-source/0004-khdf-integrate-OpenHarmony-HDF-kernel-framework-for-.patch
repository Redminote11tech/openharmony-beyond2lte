+    }
+    /* power up. */
+    if (cntlr->ops->setPowerMode != NULL) {
+        cntlr->ops->setPowerMode(cntlr, MMC_POWER_MODE_POWER_OFF);
+    }
+    if (cntlr->ops->setBusWidth != NULL) {
+        cntlr->ops->setBusWidth(cntlr, BUS_WIDTH1);
+    }
+}
