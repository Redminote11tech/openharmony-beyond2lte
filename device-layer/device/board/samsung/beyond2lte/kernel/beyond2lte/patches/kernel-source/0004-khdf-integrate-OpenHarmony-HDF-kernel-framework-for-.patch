+    HDF_LOGD("%s: name=%{public}s, id=%{public}d, flashMode=%{public}d, flashIntensity=%{public}d", __func__,
+        flashConfig->name, flashConfig->id, flashConfig->flashMode, flashConfig->flashIntensity);
