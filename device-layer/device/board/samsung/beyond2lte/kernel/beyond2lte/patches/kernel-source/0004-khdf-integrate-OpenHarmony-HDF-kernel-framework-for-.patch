+        ADM_LOG_INFO("DSP [%s] is registered!", configData->dspName);
+        ADM_LOG_INFO("DSPDAI [%s] is registered!", configData->dspDaiName);
+    }
+    audioCard->rtd->complete = AUDIO_DAI_LINK_COMPLETE;
+    ADM_LOG_DEBUG("All devices register complete!");
+
+    return HDF_SUCCESS;
