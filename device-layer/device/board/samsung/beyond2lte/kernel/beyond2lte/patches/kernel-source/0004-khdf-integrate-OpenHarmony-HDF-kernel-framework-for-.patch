+    std::vector<HdiDevHostInfo> deviceInfos;
+    (void)devmgr->ListAllDevice(deviceInfos);
+    PrintALLDeviceInfoUser(deviceInfos);
+}
+
+static void GetAllDeviceKernelSpace()
+{
+    struct HdfSBuf *data = HdfSbufObtain(DATA_SIZE);
