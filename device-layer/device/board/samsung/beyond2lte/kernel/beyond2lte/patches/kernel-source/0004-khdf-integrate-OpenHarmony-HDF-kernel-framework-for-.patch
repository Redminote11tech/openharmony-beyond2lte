+    }
+
+    int ret = RegulatorNodeForceDisable(node);
+    if (ret != HDF_SUCCESS) {
+        HDF_LOGE("RegulatorForceDisable: RegulatorNodeForceDisable fail!");
+        return ret;
+    }
+
+    return HDF_SUCCESS;
+}
+
+int32_t RegulatorSetVoltage(DevHandle handle, uint32_t minUv, uint32_t maxUv)
