+/* CameraBuffer flags */
+enum BufferFlags {
+    BUFFER_DEVICE_SYNCED = (1 << 0),
+    BUFFER_NEED_USER_SYNC = (1 << 1),
+    BUFFER_NEED_DEVICE_SYNC = (1 << 2),
+    BUFFER_PREPARED = (1 << 3),
+};
