+    {RTC_TEST_CMD_RTC_FUNCTION_TEST,          RtcTestSample,                "RtcTestSample"               },
+    {RTC_TEST_CMD_RTC_WR_RELIABILITY,         RtcReadWriteReliability,      "RtcReadWriteReliability"     },
