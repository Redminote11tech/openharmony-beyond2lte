+struct DaiData *DaiDataFromCard(const struct AudioCard *card)
+{
+    if (card == NULL || card->rtd == NULL || card->rtd->cpuDai == NULL) {
+        AUDIO_DRIVER_LOG_ERR("param is null.");
+        return NULL;
+    }
+    return card->rtd->cpuDai->devData;
+}
