+        header_file = """
+            typedef struct {
+                int32_t (*RunExtra)(struct InputControllerDesc desc);
+            } InputController;
+        """
+        parser = HeaderParser()
+        hjson = json.loads(CppHeaderParser.CppHeader(header_file, "string").toJSON())
+        parser._extract_interface(hjson["classes"]["InputController"])
