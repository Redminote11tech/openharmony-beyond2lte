+    HDMI_CEC_LOG_ADDR_TUNER_1 = 3,
+    HDMI_CEC_LOG_ADDR_PLAYBACK_DEVICE_1 = 4,
+    HDMI_CEC_LOG_ADDR_AUDIO_SYSTEM = 5,
+    HDMI_CEC_LOG_ADDR_TUNER_2 = 6,
+    HDMI_CEC_LOG_ADDR_TUNER_3 = 7,
+    HDMI_CEC_LOG_ADDR_PLAYBACK_DEVICE_2 = 8,
