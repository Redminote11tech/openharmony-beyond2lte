+};
+
+/**
+ * @brief Defines a mutex.
+ */
+#define OSAL_DECLARE_MUTEX(mutex) struct OsalMutex mutex
+
+/**
+ * @brief Initializes a mutex.
+ *
+ * @param mutex Indicates the pointer to the mutex {@link OsalMutex}.
