+static void DeviceTokenClntConstruct(struct DeviceTokenClnt *tokenClnt, struct IHdfDeviceToken *tokenIf)
+{
+    tokenClnt->tokenIf = tokenIf;
+    tokenClnt->deviceInfo = NULL;
