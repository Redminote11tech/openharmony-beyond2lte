+bool ConfigNode::IsBaseNode()
+{
+    if (GetNodeType() != NODE_NOREF && GetNodeType() != NODE_TEMPLATE) {
+        return false;
+    }
+    for (auto obj = Child(); obj != nullptr; obj = obj->Next()) {
+        if (!obj->IsNode()) {
+            continue;
+        }
+        if (!CastFrom(obj)->IsBaseNode()) {
+            return false;
+        }
+    }
+
+    return true;
+}
