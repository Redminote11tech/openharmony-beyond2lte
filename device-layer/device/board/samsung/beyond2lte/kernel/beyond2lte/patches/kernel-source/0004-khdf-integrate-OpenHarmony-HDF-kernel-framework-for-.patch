+int32_t HdfWifiGetBusIdx(void)
+{
+    struct HdfConfigWlanRoot *rootConfig = NULL;
+    rootConfig = HdfWlanGetModuleConfigRoot();
+    if (rootConfig != NULL) {
+        return rootConfig->wlanConfig.deviceList.deviceInst[0].bus.busIdx;
+    }
+    return -1;
