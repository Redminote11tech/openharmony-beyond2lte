+    cntlr = I2sGetCntlrByBusNum(number);
+    if (cntlr == NULL) {
+        HDF_LOGE("I2sOpen: cntlr is null!");
+        return NULL;
+    }
+
+    int ret = I2sCntlrOpen(cntlr);
+    if (ret != HDF_SUCCESS) {
+        HDF_LOGE("I2sOpen: i2s cntlr open fail!");
+        return NULL;
+    }
