+};
+
+struct PowerSetting {
+    struct PowerDesc  *power;
+    uint32_t          count;
+};
+
+struct PanelConfig {
+    const char   *actPanel;
+    uint32_t     dsiDev;
+    DevHandle    pwmHandle;
