+        sb.Append(prefix).AppendFormat("if (%s == NULL) {\n", name.c_str());
+    }
+
+    sb.Append(prefix + TAB).AppendFormat("HDF_LOGE(\"%%{public}s: read %s failed!\", __func__);\n", name.c_str());
