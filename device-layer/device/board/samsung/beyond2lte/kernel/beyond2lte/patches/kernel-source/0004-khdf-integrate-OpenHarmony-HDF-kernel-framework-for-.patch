+        case AUDIO_SAPM_AIF_IN:
+            sapmComponent->PowerClockOp = AudioSapmDacPowerClock;
+            break;
+        case AUDIO_SAPM_PGA:
+        case AUDIO_SAPM_OUT_DRV:
+        case AUDIO_SAPM_INPUT:
+        case AUDIO_SAPM_OUTPUT:
+        case AUDIO_SAPM_MICBIAS:
+        case AUDIO_SAPM_MIC:
+        case AUDIO_SAPM_SPK:
