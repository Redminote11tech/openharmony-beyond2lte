index 000000000..0b836e1f5
--- /dev/null
+++ b/drivers/hdf/inner_api/utils/hdf_sbuf.h
@@ -0,0 +1,608 @@
+/*
+ * Copyright (c) 2020-2021 Huawei Device Co., Ltd.
