+    ret = drsOps->GetUint32(node, "heightMaxNum", &streamConfig->heightMaxNum, 0);
+    CHECK_PARSER_CONFIG_RET(ret, "heightMaxNum");
+    ret = drsOps->GetUint32(node, "widthMaxNum", &streamConfig->widthMaxNum, 0);
