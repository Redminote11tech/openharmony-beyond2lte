+    CHECK_RETURN_RET(ret);
+    ret = StreamSetImageSetting(comDev, &ctrlConfig, CMD_SET_FMT);
+    if (ret != HDF_SUCCESS) {
+        HDF_LOGE("%s: CMD_SET_FMT failed, ret = %{public}d", __func__, ret);
