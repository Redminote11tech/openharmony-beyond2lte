+
+#include "ast/ast.h"
+
+#include <cstdlib>
+
+#include "util/string_builder.h"
+
+namespace OHOS {
+namespace HDI {
+AST::TypeStringMap AST::basicTypes_ = {
+    {"boolean",        new ASTBooleanType()     },
+    {"byte",           new ASTByteType()        },
+    {"short",          new ASTShortType()       },
+    {"int",            new ASTIntegerType()     },
+    {"long",           new ASTLongType()        },
+    {"float",          new ASTFloatType()       },
