diff --git a/drivers/hdf/framework/support/platform/test/fuzztest/gpio_fuzzer/gpio_fuzzer.cpp b/drivers/hdf/framework/support/platform/test/fuzztest/gpio_fuzzer/gpio_fuzzer.cpp
