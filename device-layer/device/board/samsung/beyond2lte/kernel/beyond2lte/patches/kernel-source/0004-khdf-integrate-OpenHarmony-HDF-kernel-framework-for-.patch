+    struct IDeviceIoService service;
+    struct HdfDeviceObject *device;
+    int32_t (*TestEntry)(struct SdioTester *tester, int32_t cmd);
+    struct SdioFunctionConfig config;
+    uint32_t busNum;
+    DevHandle handle;
+};
+
+static inline struct SdioTester *GetSdioTest(void)
+{
+    return (struct SdioTester *)DevSvcManagerClntGetService("SDIO_TEST");
+}
+
+#endif /* SDIO_TEST_H */
diff --git a/drivers/hdf/framework/test/unittest/platform/common/spi_driver_test.c b/drivers/hdf/framework/test/unittest/platform/common/spi_driver_test.c
new file mode 100644
index 000000000..4df3e6292
--- /dev/null
