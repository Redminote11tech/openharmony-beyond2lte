+static void AcmReadBulk(struct UsbRequest *req)
+{
+    uint32_t size;
+    int32_t status = req->compInfo.status;
+    size = req->compInfo.actualLength;
+    printf("Bulk status:%d,actualLength:%u\n", status, size);
+    switch (status) {
+        case 0:
+            break;
+        case -ECONNRESET:
+        case -ENOENT:
+        case -ESHUTDOWN:
+            return;
+        default:
+            goto EXIT;
+    }
+EXIT:
+    return;
+}
