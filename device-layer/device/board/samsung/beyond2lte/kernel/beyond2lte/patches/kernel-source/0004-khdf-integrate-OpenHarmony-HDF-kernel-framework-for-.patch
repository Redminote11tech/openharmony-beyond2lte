+
+set -e
+
+OHOS_SOURCE_ROOT=$1
+KERNEL_BUILD_ROOT=$2
+KERNEL_PATCH_PATH=$3
+DEVICE_NAME=$4
+HDF_COMMON_PATCH="common"
+
+ln_list=(
+    drivers/hdf_core/adapter/khdf/linux    drivers/hdf/khdf
+    drivers/hdf_core/framework             drivers/hdf/framework
+    drivers/hdf_core/interfaces/inner_api  drivers/hdf/inner_api
