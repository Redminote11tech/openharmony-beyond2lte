+    if (data == nullptr) {
+        HDF_LOGE("LLVMFuzzerTestOneInput: uart fuzz test data is nullptr!");
+        return 0;
+    }
+
+    if (size < sizeof(struct AllParameters)) {
+        HDF_LOGE("LLVMFuzzerTestOneInput: uart fuzz test size is small!");
+        return 0;
+    }
+    OHOS::UartFuzzTest(data, size);
+    return 0;
+}
