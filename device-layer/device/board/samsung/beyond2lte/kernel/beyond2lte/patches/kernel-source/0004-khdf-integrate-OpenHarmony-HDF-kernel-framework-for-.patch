+#include "osal_mem.h"
+#include "osal_time.h"
+#include "spi_if.h"
+#include "ssp_st7789.h"
+
+#define WIDTH         240
+#define HEIGHT        320
+#define FRAME_RATE    50
+
+static struct LcdCmd g_onCmd[] = {
+    { LCD_CMD,  0x11, 120 },
