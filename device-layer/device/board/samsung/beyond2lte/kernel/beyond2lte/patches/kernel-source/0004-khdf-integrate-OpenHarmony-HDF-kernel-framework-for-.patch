+    unsigned int reserved_9[2];            /* 0x228~0x22c */
+    U_DATATYPE0 DATATYPE0;                 /* 0x230 */
+    unsigned int reserved_10;              /* 0x234 */
+    U_CSI_CTRL CSI_CTRL;                   /* 0x238 */
+    unsigned int reserved_11[6];           /* 0x23c~0x250 */
+} MipiTxRegsTypeTag;
+
