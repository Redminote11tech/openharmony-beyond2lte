+        return false;
+    }
+    return ref->Move(std::shared_ptr<AstObject>(this, [](AstObject *p) {
+        (void)p;
+    }));
+}
+
+bool ConfigNode::NodeCopyExpand(const std::shared_ptr<AstObject> &ref)
