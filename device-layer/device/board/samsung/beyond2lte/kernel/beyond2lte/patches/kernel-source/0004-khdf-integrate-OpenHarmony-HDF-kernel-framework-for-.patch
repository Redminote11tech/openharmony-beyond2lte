+void MipiDsiCntlrClose(struct MipiDsiCntlr *cntlr);
+
+/**
+ * @brief Sets configuration parameters for a MIPI DSI device.
+ *
+ * @param cntlr Indicates the MIPI DSI device obtained via {@link MipiDsiOpen}.
