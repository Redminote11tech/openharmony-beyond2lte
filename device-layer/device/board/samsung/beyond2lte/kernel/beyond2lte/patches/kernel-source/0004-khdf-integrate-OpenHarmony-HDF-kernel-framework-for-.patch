+
+    ret = CameraReceiveCropData(comDev->reqData, &ctrlConfig);
+    CHECK_RETURN_RET(ret);
+    ret = StreamSetImageSetting(comDev, &ctrlConfig, CMD_SET_CROP);
+    if (ret != HDF_SUCCESS) {
+        HDF_LOGE("%s: CMD_SET_CROP failed, ret = %{public}d", __func__, ret);
+        return ret;
+    }
+    return HDF_SUCCESS;
