index 000000000..0d1fdff96
--- /dev/null
+++ b/drivers/hdf/khdf/platform/watchdog/watchdog_adapter.c
@@ -0,0 +1,343 @@
+/*
+ * watchdog_adapter.c
+ *
+ * linux watchdog driver adapter.
+ *
