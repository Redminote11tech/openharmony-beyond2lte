+#define POLL_WAIT_TIME_MS 100
+static int32_t HdfDevEventListenTask(void *para)
+{
+    struct HdfDevListenerThread *thread = (struct HdfDevListenerThread *)para;
+    struct pollfd *pfds = NULL;
+    uint16_t pfdSize = 0;
+    int32_t pollCount = 0;
