+using GetInfoFunc = void (*)();
+static void GetAllServiceUserSpace();
+static void GetAllServiceKernelSpace();
+static void GetAllDeviceUserSpace();
+static void GetAllDeviceKernelSpace();
+static void GetAllInformation();
