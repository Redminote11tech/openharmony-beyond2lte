diff --git a/drivers/hdf/framework/tools/hdf_dev_eco_tool/resources/templates/lite/display_template/hi35xx_display_driver_source.template b/drivers/hdf/framework/tools/hdf_dev_eco_tool/resources/templates/lite/display_template/hi35xx_display_driver_source.template
