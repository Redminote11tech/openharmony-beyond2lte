+    isFailed |= !HdfSbufWriteString(rspData, capability.card);
+    isFailed |= !HdfSbufWriteString(rspData, capability.busInfo);
+    isFailed |= !HdfSbufWriteUint32(rspData, capability.capabilities);
+    CHECK_RETURN_RET(isFailed);
+    return HDF_SUCCESS;
+}
