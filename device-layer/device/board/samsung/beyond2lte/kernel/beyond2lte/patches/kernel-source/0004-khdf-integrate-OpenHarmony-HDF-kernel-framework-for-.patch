+        HDF_LOGE("HdmiOpen: dispatcher or Dispatch is NULL!");
+        return NULL;
+    }
+    ret = service->dispatcher->Dispatch(&service->object, HDMI_CMD_OPEN, NULL, NULL);
+    if (ret != HDF_SUCCESS) {
