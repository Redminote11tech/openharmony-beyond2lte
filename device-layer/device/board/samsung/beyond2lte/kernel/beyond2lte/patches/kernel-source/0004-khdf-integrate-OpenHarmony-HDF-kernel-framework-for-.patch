+static struct HdmiCecMsgLenInfo *HdmiCecGetMsgLenInfo(uint8_t opcode)
+{
+    uint32_t i;
+    uint32_t len;
+
+    len = sizeof(g_cecMsg) / sizeof(g_cecMsg[0]);
+    for (i = 0; i < len; i++) {
+        if (opcode == g_cecMsg[i].opcode) {
+            return (&g_cecMsg[i]);
+        }
+    }
+    return NULL;
+}
