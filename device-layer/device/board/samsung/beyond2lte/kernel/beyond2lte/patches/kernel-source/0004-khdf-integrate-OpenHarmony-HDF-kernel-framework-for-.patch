+    ret = drsOps->GetUint8(node, "gain", &ispConfig->gain, 0);
+    CHECK_PARSER_CONFIG_RET(ret, "gain");
+    ret = drsOps->GetUint8(node, "gamma", &ispConfig->gamma, 0);
