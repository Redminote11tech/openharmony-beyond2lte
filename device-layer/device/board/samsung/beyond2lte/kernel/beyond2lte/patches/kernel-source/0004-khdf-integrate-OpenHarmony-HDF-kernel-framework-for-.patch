+    return HDF_SUCCESS;
+}
+
+static int32_t ParseCameraLensDeviceConfig(const struct DeviceResourceNode *node,
+    struct DeviceResourceIface *drsOps, struct LensDeviceConfig *lensConfig)
+{
+    int32_t ret;
+
+    ret = drsOps->GetString(node, "name", &lensConfig->name, NULL);
