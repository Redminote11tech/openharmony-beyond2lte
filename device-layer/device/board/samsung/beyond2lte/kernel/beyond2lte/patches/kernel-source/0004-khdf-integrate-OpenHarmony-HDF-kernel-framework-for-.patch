+#define CHECK_VIBRATOR_NULL_PTR_RETURN_VALUE(ptr, ret) do { \
+    if ((ptr) == NULL) { \
+        HDF_LOGE("%s:line %d pointer is null and return errno", __func__, __LINE__); \
+        return (ret); \
+    } \
+} while (0)
