diff --git a/drivers/hdf/framework/model/camera/device_impl/src/camera_common_device.c b/drivers/hdf/framework/model/camera/device_impl/src/camera_common_device.c
new file mode 100644
index 000000000..0e5aa779b
--- /dev/null
