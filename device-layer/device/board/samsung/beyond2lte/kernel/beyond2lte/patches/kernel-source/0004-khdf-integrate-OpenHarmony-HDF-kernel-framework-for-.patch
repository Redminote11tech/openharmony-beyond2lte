+
+    rtd = audioCard->rtd;
+    if (rtd == NULL) {
+        ADM_LOG_ERR("audioCard rtd object is NULL.");
+        return HDF_ERR_IO;
+    }
+
+    dsp = rtd->dsp;
+    if (dsp != NULL && dsp->devData != NULL && dsp->devData->DspInit != NULL) {
+        /* dsp initialization */
+        int32_t ret = dsp->devData->DspInit(dsp);
+        if (ret != HDF_SUCCESS) {
+            ADM_LOG_ERR("dsp initialization fail ret=%d", ret);
+            return HDF_ERR_IO;
+        }
+    }
+
+    ADM_LOG_INFO("success.");
+    return HDF_SUCCESS;
+}
+
