+    thread->status = LISTENER_EXITED;
+    OsalMemFree(pfds);
+
+    if (selfFree) {
+        /* Exit due to async call and free the thread struct. */
+        OsalMutexDestroy(&thread->mutex);
+        OsalThreadDestroy(&thread->thread);
+        OsalMemFree(thread->pfds);
+        OsalMemFree(thread);
+    }
