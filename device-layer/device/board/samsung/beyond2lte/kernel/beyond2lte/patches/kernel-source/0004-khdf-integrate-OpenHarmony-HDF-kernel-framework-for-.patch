+void Ast::Dump(const std::string &prefix)
+{
+    Logger().Debug() << "Dump " << prefix << " AST:";
+    WalkForward([](const std::shared_ptr<AstObject> &current, int32_t walkDepth) -> int32_t {
+        Logger().Debug() << ::std::setw(walkDepth * FOUR_MULTIPLE) << " " << *current;
+        return NOERR;
+    });
+}
