+
+    if (MtdDeviceLock(mtdDevice) != HDF_SUCCESS) {
+        HDF_LOGE("MtdDeviceIsBadBlock: mtd device lock fail!");
+        return false;
+    }
+    ret = MtdDeviceIsBadBlockUnlocked(mtdDevice, addr);
+    MtdDeviceUnlock(mtdDevice);
