+    }
+    ADM_LOG_DEBUG("entry.");
+
+    rtd = audioCard->rtd;
+    if (rtd == NULL) {
+        ADM_LOG_ERR("cpuDai rtd is NULL.");
+        return HDF_ERR_IO;
+    }
+    cpuDai = rtd->cpuDai;
+    if (cpuDai != NULL && cpuDai->devData != NULL && cpuDai->devData->DaiInit != NULL) {
