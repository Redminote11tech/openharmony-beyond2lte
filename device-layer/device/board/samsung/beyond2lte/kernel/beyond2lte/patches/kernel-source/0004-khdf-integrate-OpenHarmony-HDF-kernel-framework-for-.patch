+    if (dev == NULL || dev->devBase == NULL) {
+        HDF_LOGE("%s:input parameter error!", __func__);
+        return;
+    }
+    devBase = dev->devBase;
+    if (devBase->handle != NULL) {
+        PcieClose(devBase->handle);
+        devBase->handle = NULL;
+    }
+    if (dev->priData.data != NULL) {
+        dev->priData.release(dev->priData.data);
+        dev->priData.data = NULL;
+    }
+    OsalMemFree(devBase);
+    dev->devBase = NULL;
+}
