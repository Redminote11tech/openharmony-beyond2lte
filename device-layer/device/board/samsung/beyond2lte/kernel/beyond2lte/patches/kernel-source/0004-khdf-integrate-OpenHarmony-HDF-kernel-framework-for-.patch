+    if (cntlr->caps.bits.sdioIrq > 0 && cntlr->ops != NULL && cntlr->ops->setSdioIrq != NULL) {
+        (void)cntlr->ops->setSdioIrq(cntlr, false);
+    }
+    return SdioCccrIntDisable(cntlr);
+}
