+#define TEST_SDIO_BASE_ADDR 0x100
+#define TEST_FUNC_NUM 1
+#define TEST_ADDR_OFFSET 0x10
+#define TEST_FIXED_OFFSET 0x09
+#endif
+#define TEST_TIME_OUT 1000
+#define TEST_ADDR_ADD 1
+#define TEST_FUNC0_ADDR 0xFE
+
+struct SdioTestFunc {
