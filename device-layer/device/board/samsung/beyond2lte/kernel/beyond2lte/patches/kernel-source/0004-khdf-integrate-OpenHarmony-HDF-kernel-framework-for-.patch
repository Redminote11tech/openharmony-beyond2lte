+        return HDF_FAILURE;
+    }
+
+    return HDF_SUCCESS;
+}
+
+int32_t OsalSemDestroy(struct OsalSem *sem)
+{
+    if (sem == NULL || sem->realSemaphore == NULL) {
+        HDF_LOGE("%s invalid param", __func__);
+        return HDF_ERR_INVALID_PARAM;
+    }
+
+    int32_t ret = sem_destroy((sem_t *)sem->realSemaphore);
