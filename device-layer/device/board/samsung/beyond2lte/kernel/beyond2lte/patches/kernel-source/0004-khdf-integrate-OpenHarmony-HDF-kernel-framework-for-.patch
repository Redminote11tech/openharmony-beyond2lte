+    OsalThreadDestroy(&thread5);
+#endif
+    HDF_LOGE("%s", __func__);
+
+    return 0;
+}
+
+int OsaTestALLResult(void)
+{
+    int index;
+    for (index = 0; index < OSAL_TEST_CASE_CNT; index++) {
+        if (g_osalTestCases[index] != 0) {
+            HDF_LOGE("%s %d %d", __func__, g_osalTestCases[index], index);
+            return 1;
+        }
+    }
+    return 0;
+}
+
