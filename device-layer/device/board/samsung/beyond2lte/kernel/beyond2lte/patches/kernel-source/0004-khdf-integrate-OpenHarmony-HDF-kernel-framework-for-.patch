+ * @return Returns the MIPI DSI device if the operation is successful; returns <b>NULL</b> otherwise.
+ *
+ * @since 1.0
+ */
+struct MipiDsiCntlr *MipiDsiCntlrOpen(uint8_t id);
+
+/**
+ * @brief Releases the MIPI DSI device handle.
+ *
