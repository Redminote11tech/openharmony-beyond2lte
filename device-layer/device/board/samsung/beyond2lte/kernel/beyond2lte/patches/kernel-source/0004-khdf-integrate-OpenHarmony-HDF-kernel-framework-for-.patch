+int32_t HdfCameraAddDevice(struct HdfDeviceObject *device)
+{
+    if (g_hdfDevice != NULL) {
+        HDF_LOGI("%s: already inited!", __func__);
+        return HDF_SUCCESS;
+    }
+    g_hdfDevice = device;
+    return HDF_SUCCESS;
