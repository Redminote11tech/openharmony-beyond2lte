+static void RtcTesterPut(struct RtcTester *tester)
+{
+    if (tester == NULL || tester->handle == NULL) {
+        HDF_LOGE("RtcTesterPut: tester or handle is null!");
+        return;
+    }
+
+    RtcClose(tester->handle);
+    tester->handle = NULL;
