+static void OutputDumperInfo(const char *info)
+{
+    HDF_LOGE("%s", info);
+#if defined(LOSCFG_DRIVERS_HDF_PLATFORM_DUMPER_PRINT) || defined(CONFIG_DRIVERS_HDF_PLATFORM_DUMPER_PRINT)
+    DUMPER_PRINT("%s\r\n", info);
