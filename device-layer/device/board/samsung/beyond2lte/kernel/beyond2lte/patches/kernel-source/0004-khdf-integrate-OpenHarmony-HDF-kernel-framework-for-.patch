+    nb1 = NetBufQueueDequeue(&q);
+    nb2 = NetBufQueueDequeue(&q);
+    if (nb1 == NULL || nb2 == NULL) {
+        HDF_LOGE("NetBufQueueDequeue fail");
+        NetBufQueueClear(&q);
+        return HDF_FAILURE;
