+/* Formats - A.2 Format Type Codes */
+#define UAC_FORMAT_TYPE_UNDEFINED 0x0
+#define UAC_FORMAT_TYPE_I         0x1
+#define UAC_FORMAT_TYPE_II        0x2
+#define UAC_FORMAT_TYPE_III       0x3
+
