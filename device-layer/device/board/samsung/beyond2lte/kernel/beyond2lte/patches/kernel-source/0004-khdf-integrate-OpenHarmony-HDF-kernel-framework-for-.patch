+        return ret;
+    }
+
+    OsalSleep(tester->config.writeWaitMillisecond);
+    if (g_rtcIrqCallback == HDF_FAILURE) {
+        HDF_LOGE("RtcAlarmIrqTest: rtc irq call back fail!");
+        return HDF_FAILURE;
+    }
+    g_rtcIrqCallback = HDF_FAILURE;
