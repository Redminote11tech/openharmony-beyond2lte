+#ifdef LOSCFG_DRIVERS_HDF_CONFIG_MACRO
+#define MMC_PARSE_DEVICE_INFO(node, cntlr) \
+    do { \
+        cntlr->index = HCS_PROP(node, hostId); \
+        cntlr->devType = HCS_PROP(node, devType); \
+    } while (0)
+
+#define MMC_PARSE_CNTLR_FREQ_INFO(node, cntlr) \
