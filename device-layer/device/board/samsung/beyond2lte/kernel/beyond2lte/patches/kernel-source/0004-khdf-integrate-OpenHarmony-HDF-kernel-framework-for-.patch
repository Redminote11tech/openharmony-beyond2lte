+        return HDF_FAILURE;
+    }
+    static struct IDeviceIoService testService = {
+        .Dispatch = HdfPmDriverDispatch,
+        .Open = NULL,
+        .Release = NULL,
+    };
+    deviceObject->service = &testService;
+    return HDF_SUCCESS;
+}
