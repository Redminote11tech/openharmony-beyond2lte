+void MipiDsiCntlrEnterUlps(struct MipiDsiCntlr *cntlr);
+void MipiDsiCntlrExitUlps(struct MipiDsiCntlr *cntlr);
+int32_t MipiDsiCntlrPowerControl(struct MipiDsiCntlr *cntlr, uint8_t enable);
