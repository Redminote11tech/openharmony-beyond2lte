+typedef enum {
+    WORK_MODE_LVDS = 0x0,
+    WORK_MODE_MIPI = 0x1,
+    WORK_MODE_CMOS = 0x2,
+    WORK_MODE_BT1120 = 0x3,
+    WORK_MODE_SLVS = 0x4,
+    WORK_MODE_BUTT
+} WorkMode;
+
+typedef struct {
+    uint8_t devno;
+    PhyCmvMode cmvMode;
+} PhyCmv;
+
