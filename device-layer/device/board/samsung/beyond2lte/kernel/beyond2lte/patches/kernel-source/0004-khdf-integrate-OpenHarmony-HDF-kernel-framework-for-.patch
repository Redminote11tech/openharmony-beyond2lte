+
+enum I2sTestCmd {
+    I2S_SET_CFG_TEST,
+    I2S_GET_CFG_TEST,
+    I2S_OPEN_TEST,
+    I2S_CLOSE_TEST,
+    I2S_ENABLE_TEST,
+    I2S_DISABLE_TEST,
+    I2S_READ_START_TEST,
+    I2S_WRITE_START_TEST,
+    I2S_WRITE_TEST,
+    I2S_WRITE_STOP_TEST,
