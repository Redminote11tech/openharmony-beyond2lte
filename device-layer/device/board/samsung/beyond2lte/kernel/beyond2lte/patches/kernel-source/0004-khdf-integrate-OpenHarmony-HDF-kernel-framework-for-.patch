From 875d32662164d0c28ced2acfbd278f6956255628 Mon Sep 17 00:00:00 2001
From: redminote11tech <redminote11tech@users.noreply.github.com>
Date: Wed, 23 Sep 2026 16:54:25 +0100
Subject: [PATCH 4/8] khdf: integrate OpenHarmony HDF kernel framework for 4.14

- vendored khdf/framework/inner_api + include/hdf + hc-gen tool
- linker: .init.hdf_table section in arm64 vmlinux.lds.S
- khdf Makefiles: repoint framework/third_party paths for in-tree build
- bcmdhd: drop private bcmstdlib_s (symbols provided by bounds_checking)
- device/beyond2lte hdf_config staged (from rk3568 reference)
---
diff --git a/arch/arm64/kernel/vmlinux.lds.S b/arch/arm64/kernel/vmlinux.lds.S
index 5618af553..727366a59 100644
--- a/arch/arm64/kernel/vmlinux.lds.S
+++ b/arch/arm64/kernel/vmlinux.lds.S
@@ -176,6 +176,13 @@ SECTIONS
 		INIT_RAM_FS
 		*(.init.rodata.* .init.bss)	/* from the EFI stub */
 	}
+#ifdef CONFIG_DRIVERS_HDF
+	.init.hdf_table : {
+		_hdf_drivers_start = .;
+		*(.hdf.driver)
+		_hdf_drivers_end = .;
+	}
+#endif
 	.exit.data : {
 		ARM_EXIT_KEEP(EXIT_DATA)
 	}
