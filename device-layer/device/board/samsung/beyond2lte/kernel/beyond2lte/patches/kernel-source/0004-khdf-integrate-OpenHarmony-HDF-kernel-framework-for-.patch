+#define MAX_RW_SIZE          (1024 * 1204) // 1M
+
+enum HdfVNodeClientStatus {
+    VNODE_CLIENT_RUNNING,
+    VNODE_CLIENT_LISTENING,
+    VNODE_CLIENT_STOPPED,
+    VNODE_CLIENT_EXITED,
+};
