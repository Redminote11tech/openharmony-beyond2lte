+    uint32_t  seqNum;  /**< Sequence number */
+    uint32_t  ackNum;  /**< Acknowledgment number */
+    uint8_t   offset;  /**< Header length */
+    uint8_t   flags;   /**< Flags */
+    uint16_t  window;  /**< Window size */
+    uint16_t  check;   /**< Checksum */
+    uint16_t  urgent;  /**< Urgent pointer */
+};
