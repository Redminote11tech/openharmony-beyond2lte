+    .Init = ${driver_upper_camel_case}InitDriver,
+    .Release = ${driver_upper_camel_case}ReleaseDriver,
+};
+
+HDF_INIT(g_${device_lower_camel_case}${driver_upper_camel_case}DevEntry);
