+        ret = HDF_ERR_IO;
+        goto EXIT;
+    }
+
+    if (len != sizeof(*time)) {
+        HDF_LOGE("RtcReadAlarm: read error, len: %u, size: %zu!", len, sizeof(*time));
+        ret = HDF_FAILURE;
+        goto EXIT;
+    }
+
+    if (memcpy_s(time, sizeof(*time), temp, len) != EOK) {
