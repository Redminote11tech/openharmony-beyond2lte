+static struct MipiCsiCntlr *GetCntlr(const SysProcEntryTag *s)
+{
+    if (s == NULL) {
+        HDF_LOGE("GetCntlr: s is null!");
+        return NULL;
+    }
+    return g_vfsPara.cntlr;
+}
