+#define LIGHT_MAKE_R_BIT    0X00FF0000
+#define LIGHT_MAKE_G_BIT    0X0000FF00
+#define LIGHT_MAKE_B_BIT    0X000000FF
+#define LIGHT_WAIT_TIME     50
+
