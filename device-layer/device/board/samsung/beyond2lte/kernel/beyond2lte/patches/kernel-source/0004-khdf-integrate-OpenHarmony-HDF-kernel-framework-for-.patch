+        return HDF_ERR_IO;
+    }
+    param->gpio = gpio;
+    param->func = func;
+    param->data = arg;
+
+    if (PlatformUserListenerReg((struct PlatformUserListenerManager *)service->priv, gpio, (void *)param,
+        GpioOnDevEventReceive) != HDF_SUCCESS) {
+        HDF_LOGE("GpioRegListener: PlatformUserListenerReg fail!");
+        OsalMemFree(param);
+        return HDF_ERR_IO;
+    }
+    return HDF_SUCCESS;
