+        if (ret) {
+            AUDIO_DRIVER_LOG_ERR("Dma Config Channel fail.");
+            return HDF_FAILURE;
+        }
+    } else {
+        AUDIO_DRIVER_LOG_ERR("streamType(%d) is invalid.", streamType);
+        return HDF_FAILURE;
+    }
+    return HDF_SUCCESS;
